# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/predict_future"

# ─── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED. Used to sign mobile JWTs and NextAuth session cookies.
# The app throws at module load if this is unset — set it before booting.
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3001"

# ─── Cron jobs ─────────────────────────────────────────────────────────────────
# REQUIRED. Shared secret that authenticates scheduled cron requests.
# All cron routes fail closed (401) when this is unset, so missing this in prod
# means none of the daily/weekly jobs will ever run.
CRON_SECRET="your-cron-secret-here"

# Optional tuning of the auto-resolve-opinions cron's budget (defaults shown).
# CRON_PREPROCESS_LIMIT=30
# CRON_RESOLVE_LIMIT=25
# PREPROCESS_DELAY_MS=400
# RESOLVE_DELAY_MS=600

# ─── AI providers ──────────────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"
# Gemini model pins (shared by all AI call sites via callGeminiAI helper in lib/ai/gemini.ts).
# On 404 (model deprecated), the helper auto-retries with GEMINI_FALLBACK_MODEL and caches the
# outage for 1 hour to avoid paying 2x cost on every subsequent call.
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-1.5-flash"

# ─── Finance AI extraction ─────────────────────────────────────────────────────
# Max AI extraction calls per UTC day. Resets on server restart if in-memory counter is used.
FINANCE_AI_DAILY_CAP=50
# Max generated headlines per UTC day (lib/ai/generateHeadline.ts).
# HEADLINE_DAILY_CAP=200

# ─── SMS / phone verification (MSG91) ──────────────────────────────────────────
# REQUIRED in NODE_ENV=production — verify-phone route throws at boot if missing.
# In dev (NODE_ENV !== "production"), the route returns the OTP in the response body.
MSG91_AUTH_KEY="your-msg91-auth-key"
MSG91_TEMPLATE_ID="your-template-id"
MSG91_SENDER_ID="PRDCFT"
# Set to "prod" to enforce real SMS dispatch in production; any other value (or unset)
# falls back to dev-mode behavior.
PHONE_VERIFY_MODE="dev"

# ─── Upstash Redis ─────────────────────────────────────────────────────────────
# Required in production for distributed rate-limiting and push-token buckets.
# 1. Create a free database at https://console.upstash.com
# 2. Open the database → REST API tab
# 3. Copy "UPSTASH_REDIS_REST_URL" and "UPSTASH_REDIS_REST_TOKEN" values below.
# Optional in local dev — omit to skip Redis checks (in-memory fallback used).
UPSTASH_REDIS_REST_URL="https://<your-db>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<your-rest-token>"

# Hourly cap on Expo push notifications across all instances (used by
# lib/expo-push-budget.ts to throttle big-call-push + flagship-reminder bursts).
# EXPO_PUSH_HOURLY_LIMIT=10000

# ─── Optional: cron actor for AI-generated content ─────────────────────────────
# Email of the admin user to credit as the creator of crons that mint markets
# (e.g. admin/news/backfill-predictions). Falls back to the first ADMIN if unset.
# SYSTEM_ADMIN_EMAIL="admin@example.com"
