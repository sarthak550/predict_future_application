# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/predict_future"

# ─── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3001"

# ─── AI providers ──────────────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"
# Gemini model pins (shared by all AI call sites via callGeminiAI helper in lib/ai/gemini.ts).
# On 404 (model deprecated), the helper auto-retries with GEMINI_FALLBACK_MODEL and caches the
# outage for 1 hour to avoid paying 2x cost on every subsequent call.
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-1.5-flash"

# ─── Finance AI extraction ─────────────────────────────────────────────────────
# Max AI extraction calls per UTC day. Resets on server restart if in-memory counter is used.
FINANCE_AI_DAILY_CAP=50

# ─── Upstash Redis ─────────────────────────────────────────────────────────────
# Required in production for distributed rate-limiting and push-token buckets.
# 1. Create a free database at https://console.upstash.com
# 2. Open the database → REST API tab
# 3. Copy "UPSTASH_REDIS_REST_URL" and "UPSTASH_REDIS_REST_TOKEN" values below.
# Optional in local dev — omit to skip Redis checks (in-memory fallback used).
UPSTASH_REDIS_REST_URL="https://<your-db>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<your-rest-token>"
