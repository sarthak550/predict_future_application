# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/predict_future"

# ─── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3001"

# ─── AI providers ──────────────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"
