generator client {
  provider = "prisma-client-js"
  // "native" = your Mac for local dev; "debian-openssl-3.0.x" = the Linux container
  // (node:20-bookworm-slim / Debian 12 / OpenSSL 3) used in the AWS App Runner image.
  // Without the Debian target the query engine .so is missing in the container and
  // every DB call throws at runtime.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                @id @default(cuid())
  username                   String                @unique
  email                      String                @unique
  emailVerified              DateTime?
  passwordHash               String?
  image                      String?
  avatarUrl                  String?
  role                       Role                  @default(USER)
  isSuspended                Boolean               @default(false)
  suspendedReason            String?
  reputationScore            Int                   @default(50)
  expoPushToken              String?
  accuracyScore              Float                 @default(0)
  level                      Int                   @default(1)
  streak                     Int                   @default(0)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  referralCode               String?               @unique
  referredById               String?
  currentLeagueTier          LeagueTier?
  isVerifiedAnalyst          Boolean               @default(false)
  phone                      String?               @unique
  phoneVerified              Boolean               @default(false)
  /// Lifetime tip points received across all comments. Incremented atomically on each tip transaction.
  tipsReceivedTotal          Int                   @default(0)
  /// Controls whether the user appears under their real username or an anonymised pseudonym on public surfaces.
  displayMode                UserDisplayMode       @default(USERNAME)
  /// Analyst tier earned through prediction accuracy and volume. Recomputed on market resolution and nightly cron.
  analystTier                AnalystTier           @default(ROOKIE)
  referralBonusCreditedAt    DateTime?
  accounts                   Account[]
  adminActions               AdminAction[]         @relation("AdminActor")
  targetAdminActions         AdminAction[]         @relation("AdminTargetUser")
  BigCallTap                 BigCallTap[]
  challenges                 Challenge[]           @relation("UserChallenges")
  reviewedChallenges         Challenge[]           @relation("UserReviewedChallenges")
  dailyQuests                DailyQuest[]
  expertFollows              ExpertFollow[]
  expertOpinionVotes         ExpertOpinionVote[]
  followers                  Follow[]              @relation("Followee")
  following                  Follow[]              @relation("Follower")
  ownedGroups                Group[]               @relation("OwnedGroups")
  groupMemberships           GroupMembership[]
  groupJoinRequests          GroupJoinRequest[]    @relation("JoinRequests")
  decidedJoinRequests        GroupJoinRequest[]    @relation("JoinRequestDecider")
  /// S59: User-level default notification level for all group memberships. Migrated from AsyncStorage in T2.
  defaultGroupNotificationLevel GroupNotifLevel @default(ALL)
  /// S58: per-group notification preferences set by this user.
  groupNotificationPreferences GroupNotificationPreference[]
  /// S59: moderation actions taken by this user.
  moderationActionsAsActor   GroupModerationAction[] @relation("ModerationActor")
  /// S59: moderation actions targeting this user.
  moderationActionsAsTarget  GroupModerationAction[] @relation("ModerationTarget")
  leaderboardSnapshots       LeaderboardSnapshot[]
  approvedMarkets            Market[]              @relation("ApprovedMarkets")
  createdMarkets             Market[]              @relation("CreatedMarkets")
  finalizedMarketResolutions Market[]              @relation("FinalizedMarketResolutions")
  comments                   MarketComment[]
  positions                  MarketPosition[]
  reports                    MarketReport[]        @relation("ReportedByUser")
  reviewedReports            MarketReport[]        @relation("ReviewedReports")
  resolutions                MarketResolution[]    @relation("ResolvedByUser")
  monthlyLeagueEntries       MonthlyLeagueEntry[]
  multiChoicePositions       MultiChoicePosition[]
  notifications              Notification[]
  phoneVerificationOtp       PhoneVerificationOtp?
  reasoningUpvotes           ReasoningUpvote[]
  savedMarkets               SavedMarket[]
  sessions                   Session[]
  reviewedStories            Story[]               @relation("ReviewedStories")
  createdStories             Story[]               @relation("CreatedStories")
  referredBy                 User?                 @relation("Referrer", fields: [referredById], references: [id])
  referrals                  User[]                @relation("Referrer")
  badges                     UserBadge[]
  categoryStats              UserCategoryStat[]
  stats                      UserStat?
  votes                      Vote[]
  wallet                     Wallet?
  createdPolls               Poll[]                @relation("CreatedPolls")
  pollVotes                  PollVote[]            @relation("PollVotes")
}

model LeaderboardSnapshot {
  id         String          @id @default(cuid())
  userId     String
  rank       Int
  timeWindow String
  category   MarketCategory?
  snapshotAt DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timeWindow, category, snapshotAt])
}

model PhoneVerificationOtp {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  followeeId String
  createdAt  DateTime @default(now())
  followee   User     @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followerId, createdAt])
  @@index([followeeId, createdAt])
}

model Wallet {
  id              String              @id @default(cuid())
  userId          String              @unique
  balance         Int                 @default(0)
  startingBalance Int                 @default(10000)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    WalletTransaction[]
}

model WalletTransaction {
  id                    String                @id @default(cuid())
  walletId              String
  type                  WalletTransactionType
  amount                Int
  description           String
  marketId              String?
  positionId            String?
  adminActionId         String?
  createdAt             DateTime              @default(now())
  /// Percentile rank stored at market resolution for MARKET_WIN transactions.
  /// Represents the % of other participants the user beat (0–99). Null for non-WIN transactions or solo markets.
  percentileRank        Int?
  multiChoicePositionId String?
  adminAction           AdminAction?          @relation(fields: [adminActionId], references: [id])
  market                Market?               @relation(fields: [marketId], references: [id])
  MultiChoicePosition   MultiChoicePosition?  @relation(fields: [multiChoicePositionId], references: [id])
  position              MarketPosition?       @relation(fields: [positionId], references: [id])
  wallet                Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  // M5: a partial unique index "WalletTransaction_host_market_type_uniq"
  // is also defined in migration 20260525000001_m5_host_wt_partial_unique
  // and enforces at-most-one row per (walletId, marketId, type) for the
  // host-level transaction types (HOST_BOND_LOCK / RELEASE / FORFEIT /
  // COMPENSATION, HOST_COMMISSION, HOST_REWARD). Prisma cannot model
  // partial unique indexes natively, so the constraint lives in raw SQL.

  @@unique([walletId, marketId, type, positionId])
  @@unique([walletId, marketId, type, multiChoicePositionId], map: "WalletTransaction_walletId_marketId_type_multiChoicePositionId_")
  @@index([walletId, createdAt])
  @@index([marketId])
}

model UserStat {
  id                               String    @id @default(cuid())
  userId                           String    @unique
  totalPredictions                 Int       @default(0)
  totalWins                        Int       @default(0)
  totalLosses                      Int       @default(0)
  totalMarketsCreated              Int       @default(0)
  resolvedMarketsCreated           Int       @default(0)
  creatorReputation                Int       @default(0)
  totalPointsStaked                Int       @default(0)
  totalNetPoints                   Int       @default(0)
  streak                           Int       @default(0)
  bestStreak                       Int       @default(0)
  accuracyScore                    Float     @default(0)
  lastPredictionAt                 DateTime?
  hostTrustScore                   Int       @default(30)
  validFinalizedHostedMarketsCount Int       @default(0)
  hostedMarketsCount               Int       @default(0)
  finalizedHostedMarketsCount      Int       @default(0)
  overturnedHostedMarketsCount     Int       @default(0)
  hostTimeoutCount                 Int       @default(0)
  recentHostTimeoutCount           Int       @default(0)
  challengeCount                   Int       @default(0)
  upheldChallengesCount            Int       @default(0)
  cleanFinalizationCount           Int       @default(0)
  upheldAfterChallengeCount        Int       @default(0)
  successfulResolutionsCount       Int       @default(0)
  moderationViolationCount         Int       @default(0)
  avgParticipantsPerHostedMarket   Float     @default(0)
  avgPoolPerHostedMarket           Float     @default(0)
  repeatJoinRate                   Float     @default(0)
  avgHostCommissionBps             Float     @default(0)
  cleanStreakCount                 Int       @default(0)
  publicHostingEligibility         Boolean   @default(false)
  hostingLimit                     Int       @default(1)
  currentActiveHostedMarketsCount  Int       @default(0)
  reversalRate                     Float     @default(0)
  hostingSuspendedUntil            DateTime?
  /// S62: Total free-vote poll predictions made by this user.
  totalPollPredictions             Int       @default(0)
  /// S62: Poll prediction accuracy tracked separately from market accuracy (0.0–1.0 fraction).
  pollAccuracyScore                Float     @default(0)
  updatedAt                        DateTime  @updatedAt
  user                             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserCategoryStat {
  id               String         @id @default(cuid())
  userId           String
  category         MarketCategory
  totalPredictions Int            @default(0)
  totalWins        Int            @default(0)
  totalLosses      Int            @default(0)
  totalNetPoints   Int            @default(0)
  accuracyScore    Float          @default(0)
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([category, accuracyScore])
}

model Badge {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String
  category    MarketCategory?
  createdAt   DateTime        @default(now())
  users       UserBadge[]
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  awardedAt  DateTime @default(now())
  awardedFor String?
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Source {
  id               String          @id @default(cuid())
  slug             String          @unique
  name             String          @unique
  homepageUrl      String?
  attributionLabel String?
  iconUrl          String?
  language         String          @default("en")
  trustTier        SourceTrustTier @default(REPUTABLE)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  stories          Story[]
}

model Story {
  id                String             @id @default(cuid())
  slug              String             @unique
  headline          String
  summary           String
  category          MarketCategory
  sourceId          String?
  sourceName        String
  sourceUrl         String             @unique
  imageUrl          String?
  publishedAt       DateTime
  ingestedAt        DateTime           @default(now())
  language          String             @default("en")
  status            StoryStatus        @default(DRAFT)
  ingestionType     StoryIngestionType @default(MANUAL)
  ingestionFeedId   String?
  ingestionFeedName String?
  externalId        String?            @unique
  dedupeKey         String?
  rawPayloadJson    Json?
  readTimeSeconds   Int                @default(25)
  isFeatured        Boolean            @default(false)
  isTrending        Boolean            @default(false)
  createdById       String?
  approvedById      String?
  /// Full article body text extracted via Readability (S21-T1). Null if not yet fetched.
  bodyText          String?
  /// Timestamp when body fetch was last attempted (success or failure).
  bodyFetchedAt     DateTime?
  /// True when all fetch attempts have failed (paywall, timeout, size, non-HTML, etc.).
  bodyFetchFailed   Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  latestResolvedAt  DateTime?
  adminActions      AdminAction[]
  curatedItems      CuratedFeedItem[]
  expertOpinions    ExpertOpinion[]
  market            Market?
  notifications     Notification[]
  approvedBy        User?              @relation("ReviewedStories", fields: [approvedById], references: [id])
  createdBy         User?              @relation("CreatedStories", fields: [createdById], references: [id])
  source            Source?            @relation(fields: [sourceId], references: [id])

  @@index([publishedAt(sort: Desc)])
  @@index([ingestedAt(sort: Desc)])
  @@index([status, publishedAt])
  @@index([category, status, publishedAt])
  @@index([isFeatured, isTrending, publishedAt])
  @@index([dedupeKey])
  @@index([ingestionFeedId, ingestedAt])
  @@index([latestResolvedAt(sort: Desc)])
}

model CuratedFeed {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  description String?
  feedType    CuratedFeedType
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  items       CuratedFeedItem[]
}

model CuratedFeedItem {
  id        String      @id @default(cuid())
  feedId    String
  storyId   String
  position  Int
  createdAt DateTime    @default(now())
  feed      CuratedFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  story     Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([feedId, storyId])
  @@unique([feedId, position])
  @@index([storyId])
}

model Group {
  id            String               @id @default(cuid())
  slug          String               @unique
  name          String
  description   String?
  ownerId       String
  inviteCode    String               @unique
  isArchived    Boolean              @default(false)
  /// S54: open discovery visibility model. Existing groups default to INVITE_ONLY.
  visibility    GroupVisibility      @default(INVITE_ONLY)
  /// Optional category tag for filtering in the discover feed.
  category      MarketCategory?
  /// Maximum members allowed. Default 10,000. Enforced on OPEN join path.
  memberCap     Int                  @default(10000)
  /// Cover image URL. Set by admin/seed in S54; upload UI is S58.
  coverImageUrl String?
  /// S59: Editorial curation flag. Featured groups appear first in the discover rail.
  isFeatured    Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  owner         User                 @relation("OwnedGroups", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships   GroupMembership[]
  markets       Market[]
  /// S56: join requests from users seeking entry into REQUEST_TO_JOIN groups.
  joinRequests  GroupJoinRequest[]
  /// S58: per-member notification preferences for this group.
  notificationPreferences GroupNotificationPreference[]
  /// S59: moderation audit trail.
  moderationActions GroupModerationAction[]

  @@index([ownerId, createdAt])
  @@index([visibility, createdAt])
  @@index([isFeatured, createdAt])
}

/// S56: A user's request to join a REQUEST_TO_JOIN group.
/// Unique on (groupId, userId, status) so there can be at most one PENDING request
/// per user per group. A new PENDING request after a REJECTED one is allowed because
/// the unique key includes status (different values → no constraint violation).
model GroupJoinRequest {
  id           String                 @id @default(cuid())
  groupId      String
  userId       String
  status       GroupJoinRequestStatus @default(PENDING)
  requestedAt  DateTime               @default(now())
  decidedAt    DateTime?
  decidedById  String?
  decisionNote String?

  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User   @relation("JoinRequests", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?  @relation("JoinRequestDecider", fields: [decidedById], references: [id])

  @@unique([groupId, userId, status])
  @@index([groupId, status])
}

model GroupMembership {
  id        String    @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole @default(MEMBER)
  joinedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  /// S54 ban tombstone: bannedAt != null means this user is banned from this group.
  /// A tombstone row may exist even if the user was never a full member (preemptive ban).
  /// TODO S56: migrate ban tombstones to a dedicated GroupBan table with full audit trail.
  bannedAt  DateTime?
  banReason String?
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, joinedAt])
}

model Market {
  id                             String                      @id @default(cuid())
  storyId                        String?                     @unique
  slug                           String                      @unique
  title                          String
  description                    String
  category                       MarketCategory
  template                       MarketTemplate
  marketType                     MarketType                  @default(BINARY)
  creatorId                      String
  visibility                     MarketVisibility            @default(PUBLIC)
  marketScope                    MarketScope                 @default(GLOBAL)
  groupId                        String?
  status                         MarketStatus                @default(DRAFT)
  closeAt                        DateTime
  resolveAt                      DateTime
  resolutionMode                 ResolutionMode              @default(SOURCE_BASED)
  resolutionStatus               ResolutionStatus            @default(OPEN)
  resolutionSourceType           ResolutionSourceType
  resolutionSourceName           String
  resolutionSourceUrl            String?
  resolutionRuleText             String
  fallbackRuleText               String?
  unit                           String?
  minValue                       Float?
  maxValue                       Float?
  precision                      Int?
  winnersCount                   Int                         @default(1)
  payoutDistributionJson         Json?
  tieBreakerRule                 NumericTieBreakerRule?
  rulesLockedAt                  DateTime?
  structuredData                 Json?
  outcome                        MarketOutcome               @default(UNRESOLVED)
  actualValue                    Float?
  yesPool                        Int                         @default(0)
  noPool                         Int                         @default(0)
  totalParticipants              Int                         @default(0)
  totalVolume                    Int                         @default(0)
  creatorReputationSnapshot      Int                         @default(0)
  qualityScore                   Int                         @default(0)
  disputeCount                   Int                         @default(0)
  poolRewardMode                 PoolRewardMode              @default(COMMISSION_BASED)
  hostCommissionBps              Int                         @default(0)
  bondCap                        Int                         @default(0)
  lockedBondAmount               Int                         @default(0)
  currentRequiredBond            Int                         @default(0)
  dynamicPoolEnabled             Boolean                     @default(false)
  maxPoolAllowed                 Int?
  challengeWindowHours           Int                         @default(24)
  challengeWindowEndsAt          DateTime?
  gracePeriodHours               Int                         @default(48)
  finalResolutionDeadline        DateTime?
  finalizationAt                 DateTime?
  hostResolutionNote             String?
  hostResolutionEvidenceJson     Json?
  resolutionFinalizedById        String?
  overturnedReason               String?
  yesCount                       Int                         @default(0)
  noCount                        Int                         @default(0)
  totalVotes                     Int                         @default(0)
  averageNumericValue            Float?
  isFlagged                      Boolean                     @default(false)
  isFeatured                     Boolean                     @default(false)
  approvedAt                     DateTime?
  approvedById                   String?
  createdAt                      DateTime                    @default(now())
  updatedAt                      DateTime                    @updatedAt
  eventClusterId                 String?
  sumToHundred                   Boolean                     @default(false)
  winningOptionId                String?
  /// Composite idempotency key in the form '<platform>:<remoteId>'. Unique so re-running import scripts is safe.
  externalId                     String?                     @unique
  /// Free-text identifier for the originating platform (e.g. 'manifold'). Null for native markets.
  originPlatform                 String?
  /// Engagement analytics: total opens of this market from Big Call notifications/card.
  bigCallNotificationOpenedCount Int                         @default(0)
  /// Timestamp when the Big Call push notification was sent — used as idempotency guard to prevent double-sends.
  bigCallNotificationSentAt      DateTime?
  /// Date this market was marked as 'Today's Big Call' (stored as IST midnight UTC). Null = not designated.
  isBigCallDate                  DateTime?
  /// Crowd consensus from origin platform (0..1 implied YES probability at resolution / latest snapshot). Null for native markets.
  externalProbability            Float?
  /// Unique trader count on the origin platform. Null for native markets.
  externalTraderCount            Int?
  /// Total trading volume on the origin platform (USD equivalent). Null for native markets.
  externalVolume                 Float?
  /// When set, this market is a Finance "flagship event" tied to a specific upcoming
  /// real-world date (RBI MPC, Budget, etc.). Used by the Finance tab Policy & Big Events
  /// carousel. Null for normal markets.
  flagshipEventAt                DateTime?
  /// One of: 'RBI' | 'BUDGET' | 'GST' | 'GLOBAL' | 'FED' | 'OTHER'.
  /// Plain string so we can add types without migrations.
  flagshipEventType              String?
  flagshipReminderSentAt         DateTime?
  externalLastSyncedAt           DateTime?
  adminActions                   AdminAction[]
  BigCallTap                     BigCallTap[]
  challenges                     Challenge[]
  approvedBy                     User?                       @relation("ApprovedMarkets", fields: [approvedById], references: [id])
  creator                        User                        @relation("CreatedMarkets", fields: [creatorId], references: [id], onDelete: Cascade)
  eventCluster                   MarketEventCluster?         @relation(fields: [eventClusterId], references: [id])
  group                          Group?                      @relation(fields: [groupId], references: [id])
  resolutionFinalizedBy          User?                       @relation("FinalizedMarketResolutions", fields: [resolutionFinalizedById], references: [id])
  story                          Story?                      @relation(fields: [storyId], references: [id])
  comments                       MarketComment[]
  options                        MarketOption[]
  positions                      MarketPosition[]
  probabilitySnapshots           MarketProbabilitySnapshot[]
  reports                        MarketReport[]
  resolution                     MarketResolution?
  multiChoicePositions           MultiChoicePosition[]
  notifications                  Notification[]
  savedByUsers                   SavedMarket[]
  votes                          Vote[]
  walletTransactions             WalletTransaction[]

  @@index([status, closeAt])
  @@index([status, resolveAt])
  @@index([category, status])
  @@index([creatorId, createdAt])
  @@index([visibility, status, closeAt])
  @@index([groupId, status, createdAt])
  @@index([resolutionStatus, challengeWindowEndsAt])
  @@index([marketType, visibility, status])
  @@index([eventClusterId, status])
  @@index([originPlatform, externalId])
  @@index([isBigCallDate])
  @@index([flagshipEventAt])
}

/// Hourly snapshot of binary/multi-choice market probability for the consensus-line chart.
model MarketProbabilitySnapshot {
  id          String   @id @default(cuid())
  marketId    String
  /// Probability of YES (or highest-staked option) as a fraction 0.0–1.0.
  probability Float
  snapshotAt  DateTime @default(now())
  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId, snapshotAt])
}

model MarketEventCluster {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  bannerEmoji String?
  category    MarketCategory  @default(FINANCE)
  /// Array of { label: string, value: string, subtext?: string, date?: string }
  dataPoints  Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  opinions    ExpertOpinion[]
  markets     Market[]
}

model Vote {
  id           String        @id @default(cuid())
  userId       String
  marketId     String
  side         PositionSide?
  numericValue Float?
  createdAt    DateTime      @default(now())
  market       Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, marketId])
  @@index([marketId, createdAt])
  @@index([userId, createdAt])
}

model MarketPosition {
  id                     String              @id @default(cuid())
  userId                 String
  marketId               String
  side                   PositionSide?
  numericValue           Float?
  absoluteError          Float?
  amount                 Int
  probabilityAtEntry     Float?
  estimatedReturnAtEntry Float?
  payoutAmount           Int?
  settledAt              DateTime?
  createdAt              DateTime            @default(now())
  /// Optional free-text rationale attached by the user when placing the position (max 500 chars).
  reasoning              String?
  /// Running total of reasoning upvotes from other users (S30-T1).
  reasoningUpvotes       Int                 @default(0)
  market                 Market              @relation(fields: [marketId], references: [id], onDelete: Cascade)
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reasoningUpvoteRecords ReasoningUpvote[]
  walletTransactions     WalletTransaction[]

  @@index([marketId, createdAt])
  @@index([userId, createdAt])
  @@index([marketId, numericValue])
  @@index([userId, settledAt(sort: Desc)])
}

/// Tracks which users have upvoted reasoning on a specific position (S30-T1).
model ReasoningUpvote {
  id         String         @id @default(cuid())
  positionId String
  userId     String
  createdAt  DateTime       @default(now())
  position   MarketPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([positionId, userId])
  @@index([positionId])
  @@index([userId])
}

/// One selectable option in a MULTIPLE_CHOICE market.
model MarketOption {
  id          String                @id @default(cuid())
  marketId    String
  label       String
  sortOrder   Int                   @default(0)
  isWinner    Boolean               @default(false)
  totalStaked Int                   @default(0)
  createdAt   DateTime              @default(now())
  market      Market                @relation(fields: [marketId], references: [id], onDelete: Cascade)
  positions   MultiChoicePosition[]

  @@unique([marketId, sortOrder])
  @@index([marketId])
}

/// A user's stake on one option of a MULTIPLE_CHOICE market.
model MultiChoicePosition {
  id                String              @id @default(cuid())
  userId            String
  marketId          String
  optionId          String
  amount            Int
  payoutAmount      Int?                @default(0)
  settledAt         DateTime?
  createdAt         DateTime            @default(now())
  /// Optional free-text reasoning attached to this pick. Used for flagship polls
  /// where users explain why they chose this option.
  reasoning         String?
  market            Market              @relation(fields: [marketId], references: [id], onDelete: Cascade)
  option            MarketOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  WalletTransaction WalletTransaction[]

  @@unique([userId, marketId, optionId])
  @@index([marketId, optionId])
  @@index([userId, createdAt])
}

model MarketComment {
  id           String   @id @default(cuid())
  userId       String
  marketId     String
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /// Lifetime tip total received on this comment (incremented on each tip).
  tipsReceived Int      @default(0)
  market       Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([marketId, createdAt])
}

model MarketReport {
  id           String        @id @default(cuid())
  reporterId   String
  marketId     String
  reason       String
  details      String?
  status       ReportStatus  @default(OPEN)
  reviewerId   String?
  explanation  String?
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  adminActions AdminAction[]
  market       Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  reporter     User          @relation("ReportedByUser", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer     User?         @relation("ReviewedReports", fields: [reviewerId], references: [id])

  @@index([status, createdAt])
  @@index([marketId])
}

model MarketResolution {
  id           String        @id @default(cuid())
  marketId     String        @unique
  resolvedById String?
  outcome      MarketOutcome
  actualValue  Float?
  sourceName   String
  sourceUrl    String?
  explanation  String
  auditData    Json?
  resolvedAt   DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  market       Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  resolvedBy   User?         @relation("ResolvedByUser", fields: [resolvedById], references: [id])
}

model Challenge {
  id               String          @id @default(cuid())
  marketId         String
  challengerUserId String
  reasonText       String?
  evidenceText     String?
  evidenceUrl      String?
  status           ChallengeStatus @default(OPEN)
  createdAt        DateTime        @default(now())
  reviewedAt       DateTime?
  reviewedById     String?
  challenger       User            @relation("UserChallenges", fields: [challengerUserId], references: [id], onDelete: Cascade)
  market           Market          @relation(fields: [marketId], references: [id], onDelete: Cascade)
  reviewedBy       User?           @relation("UserReviewedChallenges", fields: [reviewedById], references: [id])

  @@index([marketId, status, createdAt])
  @@index([challengerUserId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  storyId   String?
  marketId  String?
  type      NotificationType
  title     String
  body      String
  href      String?
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  market    Market?          @relation(fields: [marketId], references: [id])
  story     Story?           @relation(fields: [storyId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model AdminAction {
  id                 String              @id @default(cuid())
  actorId            String
  targetUserId       String?
  storyId            String?
  marketId           String?
  reportId           String?
  type               AdminActionType
  notes              String?
  metadata           Json?
  createdAt          DateTime            @default(now())
  actor              User                @relation("AdminActor", fields: [actorId], references: [id], onDelete: Cascade)
  market             Market?             @relation(fields: [marketId], references: [id])
  report             MarketReport?       @relation(fields: [reportId], references: [id])
  story              Story?              @relation(fields: [storyId], references: [id])
  targetUser         User?               @relation("AdminTargetUser", fields: [targetUserId], references: [id])
  walletTransactions WalletTransaction[]

  @@index([type, createdAt])
  @@index([marketId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Expert {
  id           String          @id @default(cuid())
  name         String
  organization String
  verified     Boolean         @default(false)
  bio          String?
  avatarUrl    String?
  tipranksUrl  String?
  linkedinUrl  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  followers    ExpertFollow[]
  opinions     ExpertOpinion[]

  @@unique([name, organization])
}

model ExpertFollow {
  id        String   @id @default(cuid())
  userId    String
  expertId  String
  createdAt DateTime @default(now())
  expert    Expert   @relation(fields: [expertId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, expertId])
  @@index([userId, createdAt])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model ExpertOpinion {
  id                      String                  @id @default(cuid())
  expertId                String
  storyId                 String?
  marketId                String?
  /// Nullable FK to event cluster — used for expert-takes footer count and filter UX (S18-T4)
  eventClusterId          String?
  quote                   String
  direction               OpinionDirection
  sourceUrl               String
  extractedAt             DateTime                @default(now())
  publishedAt             DateTime
  resolutionStatus        OpinionResolutionStatus @default(PENDING)
  resolvedAt              DateTime?
  resolutionNote          String?
  suppressedAt            DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  /// When true, opinion is sourced from trusted publication (not attributed to named analyst).
  /// Display as "Market Analysis from [Source]" instead of "Expert: [Analyst Name]"
  isSourceAttribution     Boolean                 @default(false)
  /// Human-readable instrument name, e.g. "Nifty 50", "HDFC Bank", "Sensex"
  instrument              String?
  /// Yahoo Finance ticker symbol, e.g. "^NSEI", "HDFCBANK.NS", "^BSESN"
  instrumentTicker        String?
  /// publishedAt + resolutionWindowDays. Null until pre-processed. Index for daily cron query.
  resolutionEligibleAt    DateTime?
  /// Days from publishedAt after which this call can be evaluated. Populated by AI during pre-processing.
  resolutionWindowDays    Int?
  headline                String?
  analystCallAt           DateTime?
  lastPreprocessAttemptAt DateTime?
  lastResolutionAttemptAt DateTime?
  preprocessAttempts      Int                     @default(0)
  resolutionAttempts      Int                     @default(0)
  notifiedAt              DateTime?
  quoteHash               String                  @default("")
  eventCluster            MarketEventCluster?     @relation(fields: [eventClusterId], references: [id])
  expert                  Expert                  @relation(fields: [expertId], references: [id])
  story                   Story?                  @relation(fields: [storyId], references: [id])
  votes                   ExpertOpinionVote[]

  @@unique([expertId, storyId, quoteHash])
  @@index([expertId, publishedAt])
  @@index([expertId, resolutionStatus, resolvedAt])
  @@index([isSourceAttribution])
  @@index([eventClusterId])
  @@index([resolutionStatus, resolutionEligibleAt])
}

model ExpertOpinionVote {
  id        String                @id @default(cuid())
  userId    String
  opinionId String
  pollType  ExpertOpinionPollType
  choice    String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  lockedAt  DateTime?
  opinion   ExpertOpinion         @relation(fields: [opinionId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, opinionId, pollType])
  @@index([opinionId, pollType])
  @@index([userId, lockedAt])
}

/// Monthly league entry — one per (userId, month). Records tier standing and net points earned in the month.
model MonthlyLeagueEntry {
  id             String     @id @default(cuid())
  userId         String
  month          String
  tier           LeagueTier
  startingTier   LeagueTier
  netPointsMonth Int        @default(0)
  finalRank      Int?
  promoted       Boolean    @default(false)
  relegated      Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([month, tier, netPointsMonth(sort: Desc)])
}

/// Daily quest progress row — one per (userId, date, questType). Completed when currentCount reaches goal.
model DailyQuest {
  id           String    @id @default(cuid())
  userId       String
  /// UTC date string in 'YYYY-MM-DD' format representing the quest day.
  date         String
  /// Quest type: 'PREDICT_3' | 'PREDICT_5' | 'VOTE_ON_POLL' | 'CREATE_MARKET'
  questType    String
  completed    Boolean   @default(false)
  rewardAmount Int       @default(0)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, questType])
  @@index([userId, date])
}

/// A market bookmarked by a user for later reference.
model SavedMarket {
  id        String   @id @default(cuid())
  userId    String
  marketId  String
  createdAt DateTime @default(now())
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, marketId])
  @@index([userId, createdAt])
}

model BigCallTap {
  id        String   @id @default(cuid())
  userId    String
  marketId  String
  dateIST   String
  createdAt DateTime @default(now())
  Market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, marketId, dateIST])
  @@index([marketId, dateIST])
}

model WeeklyDigestRun {
  id          String    @id @default(cuid())
  weekKey     String    @unique
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  userCount   Int       @default(0)
  pushCount   Int       @default(0)
}

/// S62: Lightweight free-vote poll — no stake/pool/bond fields.
/// Used for RBI MPC packs and future news polls. Fully separate from Market.
model Poll {
  id             String         @id @default(cuid())
  question       String
  description    String?
  category       MarketCategory
  status         PollStatus     @default(OPEN)
  closeAt        DateTime
  resolvedAt     DateTime?
  winningOptionId String?
  structuredData Json?
  /// Shared identifier grouping polls in the same pack (e.g., two RBI questions in one MPC pack).
  packId         String?
  /// The real-world event time this poll is tied to (e.g., RBI announcement time).
  eventAt        DateTime?
  /// Optional link to a Story for future news polls. Null in Phase 1.
  storyId        String?        @unique
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdBy      User           @relation("CreatedPolls", fields: [createdById], references: [id])
  options        PollOption[]
  votes          PollVote[]

  @@index([status, closeAt])
  @@index([packId])
  @@index([createdById, createdAt])
  @@index([category, status])
}

/// S62: One selectable option in a lightweight Poll.
model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  label     String
  sortOrder Int
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     PollVote[]

  @@index([pollId])
}

/// S62: A user's free-vote prediction on a Poll. One prediction per user per poll.
/// No stake or amount field — free-vote only.
model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  /// Null until the poll is resolved; set to true/false by the resolve flow.
  isCorrect Boolean?
  lockedAt  DateTime?
  createdAt DateTime   @default(now())
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation("PollVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
  @@index([optionId])
}

