/// S58: Per-user, per-group notification preference.
/// No row = ALL (handled in query layer; no backfill on migration).
/// Cascade-deletes when the Group or User is deleted.
model GroupNotificationPreference {
  id        String          @id @default(cuid())
  groupId   String
  userId    String
  level     GroupNotifLevel @default(ALL)
  updatedAt DateTime        @updatedAt
  createdAt DateTime        @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

/// Warm store for the latest India Macro snapshot.
/// A single row (key = "singleton") is upserted on each cron run.
/// Fields are nullable so we can do keep-last-known-good updates:
/// only overwrite a field when the new fetch returned a valid value.
model MacroSnapshot {
  id  String @id @default(cuid())
  /// Singleton discriminator — always "singleton".
  key String @unique @default("singleton")

  // RBI policy rates (scraped from rbi.org.in)
  repoRate     Float?
  crr          Float?
  slr          Float?
  sdf          Float?
  msf          Float?
  bankRate     Float?
  rbiFetchedAt DateTime?

  // IMF DataMapper projections for India
  gdpGrowth        Float?
  gdpGrowthYear    Int?
  cpiInflation     Float?
  cpiInflationYear Int?
  imfFetchedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Market Pulse (Phase 1) — NSE/BSE corporate announcements + gainer/loser
// snapshots. Code prefix is deliberately `MarketMove*`, NOT `Pulse*` — the
// `Pulse*` prefix is already taken by the Rates & Events tab's internals
// (PulseKind, PulseRibbon, PulseSheet, makePulseStyles). User-facing tab
// label is "Market Pulse"; ShowScope value is "market-moves".
//
// Data source: NSE/BSE's public (unofficial) JSON endpoints — the same ones
// nseindia.com/bseindia.com's own frontend calls. Not an official developer
// API; accepted as a Phase 1 pragmatic risk (see apps/api/lib/marketMoves/).
// ─────────────────────────────────────────────────────────────────────────

enum MarketMoveSource {
  NSE
  BSE
}

enum MarketMoveTickerType {
  STOCK
  INDEX
}

enum MarketMoveEventType {
  MERGER_ACQUISITION
  RESULTS
  BOARD_MEETING
  RATING_CHANGE
  OTHER_MATERIAL
}

enum MarketMoveDirection {
  GAINER
  LOSER
}

/// Market Pulse — NSE/BSE corporate announcement (SEBI LODR Reg 30 material event)
/// ingested from unofficial exchange JSON endpoints. Every row carries a resolved
/// ticker — items with no company/index-specific ticker are dropped at ingestion
/// (never stored here). See apps/api/lib/marketMoves/{nse,bse}.ts for the fetchers
/// and apps/api/app/api/cron/market-moves-announcements/route.ts for the cron.
model MarketMoveEvent {
  id           String               @id @default(cuid())
  source       MarketMoveSource
  /// Exchange-native identifier for this announcement (NSE seq_id / BSE NEWSID).
  sourceId     String
  /// Idempotency key for upsert-on-poll: `${source}:${sourceId}`.
  dedupeKey    String               @unique
  tickerSymbol String
  tickerType   MarketMoveTickerType @default(STOCK)
  companyName  String
  eventType    MarketMoveEventType  @default(OTHER_MATERIAL)
  headline     String
  /// Link to the exchange filing (PDF) or company detail page, when available.
  detailUrl    String?
  /// Fuller free-text body when the exchange feed provides one beyond the headline.
  rawText      String?
  /// Timestamp the exchange attached to this announcement (not our ingestion time).
  announcedAt  DateTime
  ingestedAt   DateTime             @default(now())

  @@index([announcedAt(sort: Desc)])
  @@index([tickerSymbol, announcedAt(sort: Desc)])
  @@index([source, announcedAt(sort: Desc)])
}

/// Market Pulse — gainer/loser snapshot, tracked over TWO parallel universes (see
/// `universe`): "ALL" (every NSE-listed security) and "POPULAR" (NIFTY 100). One row
/// per (sessionDate, universe, tickerSymbol); re-polled and upserted through the
/// trading session so `rank`/`changePercent` reflect the latest scan (keep-latest,
/// same pattern as MacroSnapshot). `isUnusualVolume` is a same-day cross-sectional
/// heuristic (today's volume vs. today's scanned universe), NOT a true rolling
/// historical average — there is no historical volume store in Phase 1.
model MarketMoverSnapshot {
  id              String              @id @default(cuid())
  /// Trading-session date (IST calendar day), stored at IST midnight converted to UTC.
  sessionDate     DateTime
  /// Movers universe this row belongs to: "ALL" = every NSE-listed security, no
  /// market-cap cap (the original/only universe pre-toggle); "POPULAR" = NIFTY 100
  /// constituents only (the recognizable large-cap names, now the default read).
  /// Defaults to "ALL" so rows written before this column existed keep their
  /// original (all-market) meaning. Added for the Top Movers universe toggle.
  universe        String              @default("ALL")
  tickerSymbol    String
  companyName     String
  changePercent   Float
  changeAbs       Float
  volume          Float
  /// Last traded / close price at snapshot time (₹). Nullable/additive — rows written
  /// before this column existed have no price; the live pass maps NSE's `ltp`, the EOD
  /// pass maps the bhavcopy CLOSE_PRICE. Added in the Market Pulse interactivity sprint.
  lastPrice       Float?
  /// Always null in Phase 1 — no historical volume store to compute a true rolling
  /// average against. Reserved for a Phase 2 historical-average implementation.
  avgVolume       Float?
  isUnusualVolume Boolean             @default(false)
  direction       MarketMoveDirection
  rank            Int
  snapshotAt      DateTime            @default(now())

  @@unique([sessionDate, universe, tickerSymbol])
  @@index([sessionDate, universe, direction, rank])
}

/// Market Pulse push preference stub (Phase 1b — NOT activated in Phase 1; no
/// fan-out/sender code reads this model yet). Mirrors GroupNotificationPreference's
/// per-user gating shape so activating push later only needs a sender, not a new
/// preference model or migration.
model MarketMoveNotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Market Pulse (Phase 1c) — readable, real-time stock news pulled from Google
/// News RSS per ticker, replacing raw filing text as the primary read surface.
/// Deliberately NOT 1:1 with MarketMoveEvent (a news story rarely maps to one
/// specific filing) — see apps/api/lib/marketMoves/googleNews.ts for the fetch
/// + relevance/recency/dedupe rules and market-moves-news cron for ingestion.
model MarketMoveNews {
  id           String   @id @default(cuid())
  tickerSymbol String
  companyName  String
  /// Decoded Google News RSS title with the trailing " - <Publisher>" suffix removed.
  headline     String
  /// Decoded publisher name split out of the raw RSS title.
  publisher    String
  /// Google News RSS redirect link, opened directly client-side — no server-side resolution.
  sourceUrl    String
  /// Idempotency key for upsert-on-poll: sha1(tickerSymbol + ":" + normalize(headline)).
  dedupeKey    String   @unique
  publishedAt  DateTime
  ingestedAt   DateTime @default(now())

  @@index([tickerSymbol, publishedAt(sort: Desc)])
  @@index([publishedAt(sort: Desc)])
}

/// Market Pulse Phase 2 — one row per (sessionDate, symbol) NSE EOD close, sourced
/// from the same bhavcopy CSV as MarketMoverSnapshot's EOD pass (see
/// apps/api/lib/marketMoves/bhavcopy.ts) but covering every liquid EQ-series name,
/// not just the top-100/direction movers. Written by the market-moves-movers cron's
/// EOD pass (upsert-by-symbol, idempotent). Retention is UNBOUNDED BY DESIGN — this
/// is also the future portfolios valuation source, not just the instrument-detail
/// spark line, so old sessions are never pruned.
model StockEodQuote {
  id            String   @id @default(cuid())
  /// Trading-session date (IST calendar day), stored at IST midnight converted to UTC.
  sessionDate   DateTime
  /// NSE symbol, e.g. "RELIANCE".
  symbol        String
  companyName   String
  prevClose     Float
  close         Float
  changePercent Float
  volume        Float
  /// DELIV_PER from the bhavcopy — delivery percentage. Null when the source cell is '-' / absent.
  deliveryPct   Float?
  createdAt     DateTime @default(now())

  @@unique([sessionDate, symbol])
  @@index([symbol, sessionDate(sort: Desc)])
}

// ─── Portfolios (P3.1) ──────────────────────────────────────────────────────────
//
// Virtual, cash-constrained, long-only paper-trading portfolios priced off
// StockEodQuote closes. Structurally immutable: there is deliberately NO mutable
// nav/cash/holdings field anywhere below — every derived figure (cash, holdings,
// NAV, return%) is recomputed from (startingCapital, EXECUTED PortfolioTransaction
// rows, StockEodQuote closes) by the pure functions in
// packages/business-rules/src/portfolios/engine.ts. PortfolioDailyValue is a
// nightly-cron CACHE of that computation, not a source of truth — safe to
// truncate and fully recompute at any time.
//
// See apps/api/lib/portfolios/{settlement,valuation}.ts for the cron orchestration
// and apps/web/lib/portfolios/*.ts for the request-time (web API route) orchestration.

/// A virtual paper-trading portfolio. USER portfolios are self-directed (created via
/// POST /api/portfolios, ownerUserId set, ownerExpertId null). SHADOW portfolios
/// auto-track an analyst's calls (ownerExpertId set, ownerUserId null) — schema-only
/// in P3.1, no creation path is wired up yet (future phase).
model Portfolio {
  id              String                 @id @default(cuid())
  ownerUserId     String?
  ownerExpertId   String?
  kind            PortfolioKind
  name            String
  /// Globally unique, kebab-case. Collision-suffixed at creation (see
  /// apps/web/lib/portfolios/slug.ts, mirrors apps/api/lib/finance/expertSlug.ts).
  slug            String                 @unique
  visibility      PortfolioVisibility    @default(PRIVATE)
  description     String?
  /// Fixed virtual starting capital in rupees. ₹10,00,000 = 1,000,000. Never changes
  /// after creation — the only capital a portfolio ever has.
  startingCapital Int                    @default(1000000)
  createdAt       DateTime               @default(now())
  /// Set once, the first time visibility flips PRIVATE -> PUBLIC. Persists across any
  /// later PUBLIC -> PRIVATE -> PUBLIC toggles (never reset to null once set).
  publicSince     DateTime?
  ownerUser       User?                  @relation("PortfolioOwnerUser", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerExpert     Expert?                @relation("PortfolioOwnerExpert", fields: [ownerExpertId], references: [id], onDelete: Cascade)
  transactions    PortfolioTransaction[]
  dailyValues     PortfolioDailyValue[]

  @@index([kind, visibility])
  @@index([ownerUserId])
  @@index([ownerExpertId])
}

/// A single BUY/SELL order against a Portfolio. PENDING orders may be cancelled;
/// EXECUTED rows are never mutated after settlement (app-layer enforced — no update
/// path exists for an EXECUTED row). See apps/api/app/api/cron/portfolios-settle for
/// the fill algorithm and the next-session-close execution rule.
model PortfolioTransaction {
  id                   String    @id @default(cuid())
  portfolioId          String
  /// NSE symbol, matches StockEodQuote.symbol.
  symbol               String
  side                 TxSide
  quantity             Int
  requestedAt          DateTime  @default(now())
  status               TxStatus  @default(PENDING)
  /// StockEodQuote.sessionDate of the session this order filled (or would have
  /// filled, for a CANCELLED-at-settlement row) at. Null while PENDING.
  executionSessionDate DateTime?
  /// Actual fill price (StockEodQuote.close of executionSessionDate). Null while
  /// PENDING. Never an estimate — set only at settlement time.
  priceAtTx            Float?
  /// Cancellation/rejection reason, e.g. "Insufficient cash at fill time" or
  /// "Cancelled by user". Null for EXECUTED rows and for PENDING rows.
  note                 String?
  createdAt            DateTime  @default(now())
  portfolio            Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, status])
  @@index([status, requestedAt])
  @@index([symbol, status])
}

/// Nightly-cron CACHE of a portfolio's end-of-session valuation. Fully recomputable
/// from Portfolio + PortfolioTransaction + StockEodQuote — see the section doc above.
model PortfolioDailyValue {
  id            String    @id @default(cuid())
  portfolioId   String
  sessionDate   DateTime
  cash          Float
  holdingsValue Float
  totalValue    Float
  /// (totalValue - startingCapital) / startingCapital.
  returnPct     Float
  createdAt     DateTime  @default(now())
  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, sessionDate])
  @@index([portfolioId, sessionDate(sort: Desc)])
}

enum PortfolioKind {
  USER
  SHADOW
}

enum PortfolioVisibility {
  PUBLIC
  PRIVATE
}

enum TxSide {
  BUY
  SELL
}

enum TxStatus {
  PENDING
  EXECUTED
  CANCELLED
}

// ─── Paper Trading (Phase 1) ─────────────────────────────────────────────────────
//
// A SEPARATE domain from Portfolios above — similar-looking (virtual ₹, positions,
// NSE symbols) but semantically different: immediate fills at delayed intraday LTP
// (not next-session-close), the full Indian retail cost stack simulated on every
// fill (Portfolios models none), DELIVERY/INTRADAY product-type distinction with
// real regulatory rules (no delivery shorting; INTRADAY must square off same day),
// and exactly one private account per user (no multi-account directory/leaderboard
// — that's Portfolios' job). See packages/business-rules/src/papertrading/ for the
// pure cost/replay math (costs.ts, replay.ts) shared identically by apps/api (the
// square-off cron) and apps/web (the order-placement/account routes).
//
// PaperOrder is the single source of truth and is immutable once written — every
// row is filled SYNCHRONOUSLY at creation (no PENDING state, unlike
// PortfolioTransaction), so cash/holdings/P&L are always a pure replay of this log.

/// One virtual paper-trading account per user per generation. Exactly one ACTIVE
/// account per user at a time (app-layer enforced — see
/// apps/web/lib/paperTrading/account.ts, same enforcement style as
/// PortfolioTransaction's "no update path for EXECUTED" convention). Lazily created
/// on first visit to /paper-trading. "Reset" archives the current account and
/// creates a new one at generation + 1 rather than deleting history — prior
/// generations remain queryable read-only forever.
model PaperTradingAccount {
  id              String                    @id @default(cuid())
  userId          String
  status          PaperTradingAccountStatus @default(ACTIVE)
  /// 1 on first creation, incremented by each reset. Distinguishes historical
  /// ARCHIVED accounts for the same user.
  generation      Int                       @default(1)
  /// Fixed virtual starting capital in rupees. ₹1,00,000 = 100000 — deliberately
  /// smaller than Portfolios' ₹10,00,000 ("retail trader", not "model portfolio").
  startingCapital Int                       @default(100000)
  createdAt       DateTime                  @default(now())
  /// Set when a reset archives this account. Null while ACTIVE.
  archivedAt      DateTime?
  user            User                      @relation("PaperTradingAccountOwner", fields: [userId], references: [id], onDelete: Cascade)
  orders          PaperOrder[]

  @@index([userId, status])
}

/// A single executed BUY/SELL leg against a PaperTradingAccount. Immutable once
/// written (filled synchronously at the delayed intraday LTP available at request
/// time — no PENDING state, no settlement cron). One row per executed leg; every
/// individual cost line is stored (not just totalCosts) because the itemized
/// breakdown is the product's core promise. See
/// packages/business-rules/src/papertrading/costs.ts for the exact rate constants
/// and packages/business-rules/src/papertrading/replay.ts for how a log of these
/// rows becomes holdings/cash/P&L.
model PaperOrder {
  id              String              @id @default(cuid())
  accountId       String
  /// NSE symbol, matches StockEodQuote.symbol. For an INDEX_OPTION row this is
  /// the synthetic contract symbol (e.g. "NIFTY24700CE28AUG26"), NOT the bare
  /// underlyingSymbol — see instrumentKind doc below.
  symbol          String
  side            TxSide
  /// Nullable as of Phase 2 (Index Options): genuinely meaningless for an
  /// options leg (see "what's simpler" reasoning in the Phase 2 brief — a fully
  /// prepaid option has no DELIVERY/INTRADAY distinction). Always set for
  /// EQUITY rows, both existing and future — this relaxation changes no
  /// existing query or write path.
  productType     PaperProductType?
  quantity        Int
  /// Fill price — the last delayed intraday tick at request time (EQUITY), the
  /// option premium at request time (INDEX_OPTION manual BUY/SELL), or the
  /// settled intrinsic value (INDEX_OPTION expiry settlement leg).
  fillPrice       Float
  /// Timestamp of the actual upstream tick used as the fill price (NOT
  /// createdAt — the tick can be up to ~60s stale, the intraday fetcher's own
  /// cache TTL). Persisted so the UI can honestly label "priced as of HH:MM,
  /// delayed data" on every fill rather than implying a live match.
  fillTickAt      DateTime
  grossAmount     Float
  brokerage       Float
  sttAmount       Float
  exchangeCharge  Float
  sebiFee         Float
  stampDuty       Float
  gstAmount       Float
  dpCharge        Float
  totalCosts      Float
  /// grossAmount + totalCosts (BUY, cash debited) or grossAmount - totalCosts
  /// (SELL or expiry settlement, cash credited).
  netAmount       Float
  /// Set when this order was placed via "Paper trade this call". Later legs
  /// against the same symbol continue to accrue against the same linked opinion
  /// for P&L purposes only while explicitly linked — joined on this field, never
  /// inferred from symbol alone (see the "Calls I've traded" spec).
  linkedOpinionId String?
  /// True for a leg the user placed specifically to flatten an existing
  /// position (manual square-off). Distinct from autoSquaredOff below.
  isSquareOff     Boolean             @default(false)
  /// True for a closing leg written by a cron rather than the user directly —
  /// either the EQUITY intraday auto square-off cron (Phase 1,
  /// apps/api/app/api/cron/paper-trading-squareoff) or the INDEX_OPTION expiry
  /// settlement cron (Phase 2, apps/api/app/api/cron/paper-trading-options-expiry).
  /// squareOffReason below distinguishes which one.
  autoSquaredOff  Boolean             @default(false)
  createdAt       DateTime            @default(now())
  account         PaperTradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  linkedOpinion   ExpertOpinion?      @relation(fields: [linkedOpinionId], references: [id])

  // ─── Phase 2 (Index Options) — additive columns, all null for EQUITY rows ───
  //
  // Same unified PaperOrder table as Phase 1's equity flow (see the schema
  // section of cto_assignment_brief_paper_trading_phase2.md for why this is
  // deliberately NOT a separate PaperOptionOrder table): one account, one cash
  // ledger, one order log across both asset classes.

  /// Discriminates which asset-class shape this row carries. EQUITY rows (all
  /// of Phase 1's history) default here and leave every field below null.
  instrumentKind   PaperInstrumentKind   @default(EQUITY)
  /// "NIFTY" | "BANKNIFTY" — the index, not the contract. Null for EQUITY rows.
  underlyingSymbol String?
  optionType       PaperOptionType?
  strikePrice      Float?
  /// The CONTRACT's expiry date, not the order's createdAt.
  expiryDate       DateTime?
  /// Lot size snapshotted from the live NSE option-chain response AT FILL TIME
  /// — never a hardcoded constant (lot sizes are a recurring regulatory change,
  /// most recently Jan 2026). Snapshotting is what keeps a position's historical
  /// P&L math stable if the live lot size changes after the position was opened.
  lotSize          Int?
  /// Number of lots (quantity = lots * lotSize, always kept in sync at write
  /// time). `quantity` stays the canonical total-unit count so replay.ts's core
  /// math never needs an instrumentKind branch — this is purely a UI/display
  /// convenience field.
  lots             Int?
  /// Set only when autoSquaredOff is true; distinguishes the two cron sources
  /// in UI copy ("auto-closed at session close" vs. "settled at expiry").
  squareOffReason  PaperSquareOffReason?

  // ─── Phase 4 (Index Futures) — additive column, false for every prior row ──

  /// True only for a cash-only daily mark-to-market leg (Phase 4 index
  /// futures) — quantity and grossAmount are 0, netAmount carries the signed
  /// variation-margin cash flow (side is always stored as "SELL" for this leg
  /// type by convention, so deriveCash's existing side-based cash math applies
  /// netAmount directly without a new branch — see futuresCosts.ts and
  /// replay.ts's deriveFuturesPositions), and no cost fields are ever
  /// populated (see futuresCosts.ts's leg-type dispatch, path 4). False for
  /// every other row, including EQUITY/OPTION legs which don't have this
  /// concept.
  isDailyMtm       Boolean               @default(false)

  @@index([accountId, symbol])
  @@index([accountId, createdAt])
  @@index([linkedOpinionId])
  @@index([productType, createdAt])
  @@index([accountId, instrumentKind, expiryDate])
  @@index([accountId, instrumentKind, isDailyMtm])
}

enum PaperTradingAccountStatus {
  ACTIVE
  ARCHIVED
}

enum PaperProductType {
  DELIVERY
  INTRADAY
}

/// Phase 2 (Index Options) added INDEX_OPTION; Phase 3 (Stock Options) added
/// STOCK_OPTION; Phase 4 (Index Futures) added INDEX_FUTURE. Discriminates
/// PaperOrder's asset-class shapes — see the Phase 3 brief for why stock
/// options are a DISTINCT value from INDEX_OPTION despite sharing every
/// cost-stack formula: settlement mechanism differs (forced square-off vs.
/// cash-settlement-at-intrinsic), which is exactly what this enum exists to
/// let downstream code (crons, UI badges) branch on. INDEX_FUTURE rows are
/// margin-backed (see futuresMargin.ts) and daily mark-to-market (see the
/// isDailyMtm column below) — a fundamentally different lifecycle from every
/// prepaid-premium option row, hence a distinct enum value rather than
/// reusing INDEX_OPTION.
enum PaperInstrumentKind {
  EQUITY
  INDEX_OPTION
  STOCK_OPTION
  INDEX_FUTURE
}

/// Phase 2 (Index Options). CE (call) or PE (put) — long-only, no writing.
enum PaperOptionType {
  CE
  PE
}

/// Distinguishes the automated-closing-leg sources for UI copy —
/// INTRADAY_SESSION_CLOSE is Phase 1's equity cron, OPTION_EXPIRY is Phase 2's
/// index-option cash-settlement cron, STOCK_OPTION_EXPIRY_SQUAREOFF is Phase
/// 3's stock-option forced-square-off cron. STOCK_OPTION_EXPIRY_SQUAREOFF is
/// deliberately distinct from OPTION_EXPIRY even though both fire on expiry
/// day: OPTION_EXPIRY legs are ₹0-brokerage cash settlements at intrinsic
/// value, STOCK_OPTION_EXPIRY_SQUAREOFF legs are full-cost manual-SELL-shaped
/// market orders (see optionsCosts.ts's computeOptionOrderCosts call site in
/// stockOptionSquareOff.ts) — copy that said "settled at expiry" for a stock
/// option would misrepresent physical settlement as cash settlement.
/// Phase 4 (Index Futures) adds two more: FUTURES_EXPIRY_SETTLEMENT (the
/// index-futures cash-settlement cron, brokerage ₹0 like OPTION_EXPIRY — see
/// futuresCosts.ts path 2) and FUTURES_MARGIN_CALL (the whole-account forced
/// square-off when a day's MTM leaves an account's margin headroom negative —
/// FULL brokerage + STT, same "real RMS-placed order" cost treatment as
/// STOCK_OPTION_EXPIRY_SQUAREOFF, NOT the zero-brokerage settlement path — see
/// futuresCosts.ts path 3's doc comment for why this is the easiest leg-type
/// mis-copy in the whole futures flow).
enum PaperSquareOffReason {
  INTRADAY_SESSION_CLOSE
  OPTION_EXPIRY
  STOCK_OPTION_EXPIRY_SQUAREOFF
  FUTURES_EXPIRY_SETTLEMENT
  FUTURES_MARGIN_CALL
}

/// Trading Terminal UI Overhaul (Sprint A, T1) — premium-history capture. Market
/// data, NOT account data: one shared table across every account, same posture
/// as StockEodQuote (no FK to PaperOrder/PaperTradingAccount). Populated every 5
/// minutes during NSE market hours by the paper-trading-premium-capture cron for
/// the union of (a) every (underlyingSymbol, expiryDate) with an open option
/// position across any account and (b) every (underlyingSymbol, expiryDate)
/// requested through the chain endpoint in roughly the last 15 minutes, ATM ± 5
/// strikes each. Pruned after 45 days by a separate nightly cron
/// (paper-trading-premium-snapshot-prune). See the Trading Terminal UI brief's
/// "Data layer" section for the full spec — this table exists so premium
/// history can start accruing well before the T10 chart UI that will read it.
model OptionPremiumSnapshot {
  id               String              @id @default(cuid())
  capturedAt       DateTime            @default(now())
  underlyingSymbol String
  /// Reuses the existing PaperInstrumentKind enum's option values only
  /// (INDEX_OPTION | STOCK_OPTION) — never EQUITY, no new enum needed.
  instrumentKind   PaperInstrumentKind
  expiryDate       DateTime
  strikePrice      Float
  optionType       PaperOptionType
  lastPrice        Float?
  bidPrice         Float?
  askPrice         Float?
  underlyingValue  Float

  @@index([underlyingSymbol, expiryDate, strikePrice, optionType, capturedAt])
  @@index([capturedAt])
}

/// Instrument Page v2 — singleton-per-symbol cache for Yahoo-sourced
/// fundamentals + dividend history, and the rate-limit guard for on-demand
/// Google News refresh on the long-tail (non-Market-Pulse-universe) symbols.
/// Two independent TTL clocks live on one row because they gate two
/// unrelated background jobs at different cadences (fundamentals ~quarterly,
/// news ~intraday) — see apps/web/lib/finance/enrichment.ts for the
/// read-through/stale-while-revalidate logic that owns both.
///
/// Request-driven, NOT cron-driven (unlike MarketMoveNews/StockEodQuote):
/// pre-warming fundamentals for the full ~2,000-stock NSE universe would
/// fetch data almost nobody views. A row is created lazily on first visit
/// to /instruments/[symbol] and refreshed only while that symbol keeps
/// getting traffic.
///
/// JSON (not column-per-metric) for the fundamentals series deliberately:
/// Yahoo's `type` keys that actually return data vary by stock (see
/// apps/web/lib/finance/fundamentals.ts's doc comment for the empirical
/// spot-check across large/mid/small-cap NSE names) — a rigid schema would
/// need a migration every time real-world coverage shifts.
model InstrumentEnrichment {
  id          String  @id @default(cuid())
  symbol      String  @unique
  companyName String?

  /// Each series: [{ periodEnd: ISO date string ("YYYY-MM-DD"), value: number (raw INR) }],
  /// oldest first. Null until the first successful fetch; a series absent
  /// from Yahoo's response for this symbol is omitted from the JSON array
  /// entirely (never a zero-valued placeholder — see fundamentals.ts).
  annualRevenue       Json?
  annualNetIncome     Json?
  annualDilutedEps    Json?
  quarterlyRevenue    Json?
  quarterlyNetIncome  Json?
  quarterlyDilutedEps Json?

  /// [{ date: ISO date string, amount: number (raw INR per share) }], oldest first.
  dividends Json?

  /// Last successful-or-attempted fundamentals fetch. Null = never fetched.
  /// A background refresh triggers when this is null or older than the
  /// 7-day TTL (Decision 1) — checked, not enforced, by enrichment.ts.
  fundamentalsFetchedAt DateTime?

  /// Last time the on-demand news refresh ran for this symbol, hit or miss
  /// (set optimistically BEFORE the fetch, as a cheap check-and-set race
  /// guard — see enrichment.ts). Independent of fundamentalsFetchedAt: gates
  /// the 6-hour Google News refresh cadence, writes land in the existing
  /// MarketMoveNews table, not here.
  newsLastCheckedAt DateTime?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
