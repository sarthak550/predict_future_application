{
  "name": "@predict-future/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate --schema prisma/schema.prisma",
    "dev": "next dev -p 3001",
    "prebuild": "prisma generate --schema prisma/schema.prisma",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "npx tsc --noEmit",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:push": "prisma db push --schema prisma/schema.prisma && prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma && prisma generate --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "ingest:news": "tsx scripts/ingest-news.ts",
    "prisma:push:prod": "bash -c 'set -a; source .env.prod; set +a; prisma db push --schema prisma/schema.prisma && prisma generate --schema prisma/schema.prisma'",
    "prisma:seed:prod": "tsx --env-file=.env --env-file=.env.prod prisma/seed.ts",
    "ingest:news:prod": "tsx --env-file=.env --env-file=.env.prod scripts/ingest-news.ts",
    "manifold:import:prod": "tsx --env-file=.env --env-file=.env.prod scripts/import-manifold-markets.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@predict-future/api-client": "*",
    "@predict-future/auth-shared": "*",
    "@predict-future/business-rules": "*",
    "@predict-future/config": "*",
    "@predict-future/types": "*",
    "@predict-future/ui-tokens": "*",
    "@predict-future/utils": "*",
    "@predict-future/validation": "*",
    "@prisma/client": "^5.22.0",
    "@types/jsdom": "^28.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jsdom": "^27.0.1",
    "jsonwebtoken": "^9.0.3",
    "next": "^14.2.24",
    "next-auth": "^4.24.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.24",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
