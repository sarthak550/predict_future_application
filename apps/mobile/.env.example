# URL of the shared apps/api backend. Must be reachable from the Android device/emulator.
# - Emulator on the same machine: use http://10.0.2.2:3001
# - Physical device: use your machine's LAN IP, e.g. http://192.168.1.42:3001
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# EXPO_PUBLIC_DEMO_USER_ID is intentionally removed — never inline a real user CUID
# into the JS bundle. Mobile auth uses Bearer JWT from the login flow.

# Optional: PostHog product analytics. Leave blank to disable telemetry.
# Sign up at https://posthog.com, grab the Project API Key (starts with phc_).
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
