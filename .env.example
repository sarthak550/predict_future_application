DATABASE_URL="postgresql://postgres:postgres@localhost:5432/predict_future"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
CRON_SECRET="replace-with-a-second-long-random-secret"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
EXPO_PUBLIC_API_BASE_URL="http://localhost:3001"
EXPO_PUBLIC_DEMO_USER_ID=""
RSS_SOURCE_IDS="google-news-general,bbc-world,espn-news,techcrunch,cnbc-top,google-news-tech"
RSS_MAX_ITEMS_PER_SOURCE="50"
RSS_CACHE_REVALIDATE_SECONDS="900"
NEWS_API_FALLBACK_ENABLED="true"
GNEWS_API_KEY="optional-gnews-fallback-key"
GNEWS_TOP_HEADLINE_PAGES="1"
GNEWS_KEYWORD_PAGES="1"
GNEWS_REQUEST_DELAY_MS="1200"
NEWSAPI_API_KEY="optional-newsapi-fallback-key"
NEWS_INGESTION_CATEGORIES="GENERAL,SPORTS,BUSINESS,TECH,ENTERTAINMENT"
TRUSTED_HOST_FIXED_COMMISSION_BPS="200"
TRUSTED_HOST_CHALLENGE_WINDOW_HOURS="12"
TRUSTED_HOST_DEFAULT_BOND_CAP="500"
PRIVATE_HOST_COMMISSION_PRESETS_BPS="0,200,500"
PRIVATE_HOST_CHALLENGE_WINDOW_OPTIONS_HOURS="6,12,24"
HOST_MINIMUM_BOND_CAP="100"
HOST_MAX_GRACE_PERIOD_HOURS="48"
HOST_DEFAULT_GRACE_PERIOD_HOURS="48"
SEED_ADMIN_EMAIL="admin@predictfuture.local"
SEED_ADMIN_PASSWORD="Admin12345!"

# ─── Upstash Redis (apps/api) ──────────────────────────────────────────────────
# Required in production. Provides distributed rate-limiting and push-token buckets.
# 1. Create a free database at https://console.upstash.com
# 2. Open the database → REST API tab
# 3. Copy REST URL and REST Token below.
# Omit in local dev to skip Redis (in-memory fallback, not durable).
UPSTASH_REDIS_REST_URL="https://<your-db>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<your-rest-token>"

# ─── Auth (apps/web) — S74 ──────────────────────────────────────────────────────
# Production is Google-only. ALLOW_CREDENTIALS_LOGIN (server) and its client-visible
# mirror NEXT_PUBLIC_ALLOW_CREDENTIALS_LOGIN default unset/false = credentials
# sign-in/sign-up disabled. Set both "true" in local dev/CI so seed workflows and
# QA keep working without a Google Cloud test-user grant per engineer. Never set
# on the prod pf-web container. See docs/GOOGLE_OAUTH_SETUP.md for the Google
# Cloud Console steps that produce GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET.
ALLOW_CREDENTIALS_LOGIN="true"
NEXT_PUBLIC_ALLOW_CREDENTIALS_LOGIN="true"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
