{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "NEXTAUTH_URL",
    "NEXTAUTH_SECRET",
    "CRON_SECRET",
    "GEMINI_API_KEY",
    "GROQ_API_KEY",
    "FINANCE_AI_DAILY_CAP",
    "PHONE_VERIFY_MODE",
    "MSG91_AUTH_KEY",
    "MSG91_TEMPLATE_ID",
    "MSG91_SENDER_ID",
    "EXPO_PUBLIC_API_BASE_URL",
    "EXPO_PUBLIC_DEMO_USER_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "prisma:generate": {
      "cache": false
    },
    "prisma:push": {
      "cache": false
    },
    "prisma:migrate": {
      "cache": false
    },
    "prisma:seed": {
      "cache": false
    }
  }
}
